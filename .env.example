# Copy to .env and edit. The authoritative table — defaults, and which component reads
# what — is in RUNBOOK.md. scripts/demo.sh and scripts/chaos.sh set all of this
# themselves, so you only need this file for the runbook's manual "Start / stop" path.
#
# CLOSE-3 correction: this file used to name WEBHOOK_SECRET_CRM/_BILLING/_SUPPORT and
# INGEST_SOURCES=crm,billing,support, which the boot assertion has not accepted since
# F-1c — an operator who copied it and set every secret in it still could not start the
# service. The names below are the ones `sources.ts` actually demands.

DATABASE_URL=postgres://switchboard:switchboard@localhost:5433/switchboard

# --- Secrets: REQUIRED, and they fail closed --------------------------------
# There is no silent fallback. With these unset the process throws at boot or first
# use rather than quietly signing with a key that is published in this repository.
# One secret per source, so a leaked secret compromises one source, not all of them.
# Each is asserted at boot only when its source is in INGEST_SOURCES.
WEBHOOK_SECRET_HUBCRM=
WEBHOOK_SECRET_STRIPEFEED=
WEBHOOK_SECRET_CASEBUS=
WEBHOOK_SECRET_SUPPORT=
# Only if you enable these sources as well:
# WEBHOOK_SECRET_BILLING=
# WEBHOOK_SECRET_SHEETS=
LEDGER_HMAC_KEY=

# Local demo and test use ONLY: opts in to the published demo values
# (demo-secret-<source>, demo-ledger-key) in place of the secrets above.
#
# COMMENTED OUT ON PURPOSE (CLOSE-3 / SEC-I4). README's posture claim is that secrets
# fail closed and "a production deploy that forgets to set them refuses to start" — a
# template that ships the opt-out ON is precisely the forgetting-to-set-them case, and
# it started. demo.sh, chaos.sh and the vitest configs all set this for themselves, so
# uncommenting it here is never needed for the proofs; the RUNBOOK's manual Start/stop
# block exports it inline, where it is a visible, deliberate operator act rather than a
# line inherited invisibly by copying a template. Never set it in a real deployment.
# ALLOW_DEV_SECRETS=1

# --- Ledgers: one append-only file per mock process --------------------------
# Each mock writes its own ledger; for the LEDGER-FEED sources (billing, support)
# reconcile FAILS naming any enabled source whose path is unset, and the literal `skip`
# opts a source out explicitly.
# _HUBCRM is the exception and is here for the MOCK's benefit only: hubcrm reconciles
# against the vendor's object store, so nothing in ingest reads this path (gate-H I9,
# and the register's entry for the write-only emission ledger).
LEDGER_PATH_HUBCRM=./out/ledger-hubcrm.jsonl
LEDGER_PATH_BILLING=./out/ledger-billing.jsonl
LEDGER_PATH_SUPPORT=./out/ledger-support.jsonl

# Set per mock process — each one exports its own path from those above.
LEDGER_PATH=./out/ledger-support.jsonl

# --- Pipeline ----------------------------------------------------------------
# The code default is billing,support only (F-1c retired the crm mock; nothing serves
# 4001). Pin this explicitly for anything real — in particular hubcrm MUST be enabled
# on the process that should run its hydration pump.
INGEST_SOURCES=hubcrm,stripefeed,casebus,support

# Optional. The ONE tenant this deployment's doors, queue envelope and worker write
# under, resolved once at boot. Unset → the default tenant. One deployment serves one
# configured tenant; this is not a tenant selector.
# SWITCHBOARD_TENANT_ID=

# Optional. Identity for one ingest process, echoed by GET /status. demo.sh and chaos.sh
# mint one per run and refuse to drive :4002 unless it comes back — an open socket proves
# something is listening, not that it is the server they started. Leave unset for manual
# runs; nothing checks it then.
# INGEST_INSTANCE_ID=

# The agent's pool — REQUIRED, and never derived (A1, Phase 3). switchboard_agent is a
# database-enforced read-only role that cannot write and cannot see the raw or ingest
# schemas at all. The old behaviour derived this from DATABASE_URL when unset, which
# meant the full-privilege credential had to be present in the agent's environment for
# the agent to run — the exact opposite of the property the README publishes. It now
# fails closed naming this variable. The value below is the local dev credential
# migration 005 mints (same class as the committed docker-compose password).
AGENT_DATABASE_URL=postgres://switchboard_agent:switchboard_agent@localhost:5433/switchboard

# The migration-minted application role's password. Migration 006 creates
# switchboard_app with a password equal to its own name — a local-dev credential that
# does not vary per installation, holding write access to every table in raw and ingest.
# Set this and re-run `npm run migrate` to replace it; or rotate out of band with
# `alter role switchboard_app password '<new secret>'`, which re-migration does not
# reset while this variable is unset.
# APP_DB_PASSWORD=

# Optional. Without it the Monday report is a deterministic template (risk table plus
# watch list) rather than a failure.
ANTHROPIC_API_KEY=

# The CRM-side pool for the PROPOSER daemon and the EXECUTOR daemon — REQUIRED by
# `crm/src/main.ts` and `scripts/executor-loop.ts`, and NEVER derived from DATABASE_URL:
# the role it authenticates as IS the privilege boundary (migration 016, and db.ts's own
# words). It must be `switchboard_crm` — a non-owner role that can write exactly the
# columns 016's grant block lists and nothing else; the proposer refuses to start as any
# other role. DATABASE_URL stays the migration owner, which is what the OPERATOR CLIs
# (intake, question editor, settings, crm-call-test) connect as — human-invoked and
# deliberate, never a daemon. The value below is the local dev credential migration 016
# mints (same class as AGENT_DATABASE_URL's above).
CRM_DATABASE_URL=postgres://switchboard_crm:switchboard_crm@localhost:5433/switchboard

# The numbers this deployment may DIAL — the call twin of SWITCHBOARD_EMAIL_ALLOWLIST,
# and the same doctrine: FAIL-CLOSED. Unset or empty means the executor refuses every
# approved call before it starts (nothing is burned; the proposal stays approved), and
# the LIVE call transport refuses to even construct. A malformed entry (anything not
# exact E.164, e.g. +639171234567) is a STARTUP FAILURE, never a silently-dropped entry.
# Exact-match only: no prefixes, no wildcards, no country-level allow. Checked twice —
# in the executor before the execution claim, and in the transport immediately before
# the dial. Comma-separated. Start with YOUR OWN number for the first test call.
# SWITCHBOARD_PHONE_ALLOWLIST=+639171234567

# The approval service (Phase 3 / A1) — the process that RECORDS what the agent proposes.
# The agent never writes to the database; it posts a validated object to this service's
# door, and this service performs the INSERT as switchboard_approval: a non-owner role
# holding select+insert on one table and nothing else (migration 014). It must NOT be
# pointed at DATABASE_URL's role — that is the migration owner, which can grant privileges
# to switchboard_agent and so could delete the read-only claim rather than defeat it. The
# service refuses to start on any other role.
APPROVAL_DATABASE_URL=postgres://switchboard_approval:switchboard_approval@localhost:5433/switchboard

# Where the agent posts proposals. No default on purpose: a default makes "the approval
# service is down" look like "the operator forgot".
APPROVAL_BASE_URL=http://127.0.0.1:4009

# The bearer secret for that door. REQUIRED and fail-closed, same rule as the webhook
# secrets — blank here so a copied template cannot boot on a published value.
AGENT_PROPOSAL_TOKEN=

# Optional. Loopback bind and port for the approval service; and the flood-control cap on
# pending proposals (integer >= 1, default 100) — raise it only if a human can keep up.
# APPROVAL_BIND_HOST=127.0.0.1
# APPROVAL_PORT=4009
# PENDING_PROPOSAL_CAP=100

# The human approval surface (A0b) — OPT-IN. Setting APPROVAL_HUMAN_SURFACE=1 registers
# /login, /queue and /decide (magic-link login, database-backed sessions, CSRF defence)
# and makes APPROVAL_SESSION_SECRET and APPROVAL_PUBLIC_URL required at boot, fail-closed.
# APPROVAL_PUBLIC_URL is the origin the APPROVER'S BROWSER uses (sign-in links are minted
# under it) — distinct from APPROVAL_BASE_URL, where the AGENT posts. Boot through
# `npx tsx scripts/approval-service.ts` so sign-in links ride the real SMTP transport; the
# approver's address must be on SWITCHBOARD_EMAIL_ALLOWLIST. APPROVAL_COOKIE_INSECURE=1
# exists ONLY for plain-http local development (drops the __Host-/Secure cookie, loudly).
# APPROVAL_HUMAN_SURFACE=1
# APPROVAL_SESSION_SECRET=
# APPROVAL_PUBLIC_URL=http://127.0.0.1:4009
# APPROVAL_COOKIE_INSECURE=1
